// Zenoh client config for an mTLS-protected router.
//
// Copy this to the robot, replace the certificate paths, and point
// `zenoh_config` in config.yaml at it. Then set the router address with the
// tls scheme, e.g. ZENOH_ROUTER_ACCESS_POINT=tls/192.168.1.100:7447
//
// Certificates are issued with certpaste (https://github.com/sbgisen/certpaste):
//   certpaste request --san <this robot's IP>   # on the robot
//   certpaste sign                              # on the CA host
//   certpaste install                           # on the robot
//
// `connect/endpoints` is intentionally absent: connect_openrmf_by_zenoh.py
// fills it in from ZENOH_ROUTER_ACCESS_POINT.
{
  mode: "client",
  transport: {
    link: {
      tls: {
        root_ca_certificate: "/home/kachaka/sbgisen/certs/ca.crt",
        // Present this robot's certificate to the router (mutual TLS).
        enable_mtls: true,
        // Check the dialed address against the router certificate's SAN.
        verify_name_on_connect: true,
        connect_private_key: "/home/kachaka/sbgisen/certs/peer.key",
        connect_certificate: "/home/kachaka/sbgisen/certs/peer.crt",
      },
    },
  },
}
